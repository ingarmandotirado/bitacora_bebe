rules_version = '2';
// Solo estas dos cuentas pueden leer y escribir la bitácora.
// Cambia los correos por los de ustedes y publica en Firebase → Firestore Database → Reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['CORREO_MAMA@ejemplo.com', 'CORREO_PAPA@ejemplo.com'];
    }
  }
}
